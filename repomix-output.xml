<file path="src/middlewares/rateLimitHandler.js">
import rateLimit, { ipKeyGenerator } from 'express-rate-limit';

// 429 in the same shape the auth middleware uses, so the frontend can
// branch on `error` like it does for INVALID_TOKEN / TOKEN_EXPIRED,
const tooManyRequests = (message) => (req, res) =>
  res.status(429).json({
    success: false,
    message,
    error: 'TOO_MANY_REQUESTS',
  });

const normalize = (value) =>
  typeof value === 'string' ? value.trim().toLowerCase() : '';

const baseOptions = {
  standardHeaders: 'draft-7', // RateLimit-* headers (+ Retry-After on 429)
  legacyHeaders: false,       // no X-RateLimit-* headers
};

const FIFTEEN_MINUTES = 15 * 60 * 1000;
const ONE_HOUR = 60 * 60 * 1000;

// ------------------------------- Login ---------------------------------------

// Broad limit per IP: stops one client from trying many emails.
// skipSuccessfulRequests: only failed attempts (401/403) count.
export const loginIpLimiter = rateLimit({
  ...baseOptions,
  windowMs: FIFTEEN_MINUTES,
  limit: 30,
  skipSuccessfulRequests: true,
  handler: tooManyRequests('Too many login attempts. Please try again later.'),
});

// Strict limit per IP + email: stop password guessing on one account.
// Keyed on IP too, as an attacker cannot lock a victim out from everywhere.
export const loginAccountLimiter = rateLimit({
  ...baseOptions,
  windowMs: FIFTEEN_MINUTES,
  limit: 5,
  skipSuccessfulRequests: true,
  keyGenerator: (req) =>
    `${ipKeyGenerator(req.ip)}|${normalize(req.body?.email)}`,
  handler: tooManyRequests('Too many login attempts. Please try again later.'),
});

// --------------------------- Reset password ----------------------------------

// Identify here is email + firstname + firstLastname. So this endpoint is the
// easier one to bruce-force. Every request counts, successful or not.

export const resetPasswordIpLimiter = rateLimit({
  ...baseOptions,
  windowMs: ONE_HOUR,
  limit: 10,
  handler: tooManyRequests('Too many password reset attempts. Please try again later.'),
});

export const resetPasswordAccountLimiter = rateLimit({
  ...baseOptions,
  windowMs: ONE_HOUR,
  limit: 3,
  keyGenerator: (req) =>
    `${ipKeyGenerator(req.ip)}|${normalize(req.body?.email)}`,
  handler: tooManyRequests('Too many password reset attempts. Please try again later.'),
});

// ------------------------------ GraphQL --------------------------------------
// Coarse IP flood protection for /api/v1/graphql. Account-level brute-force
// protection for login/resetPassword lives in the auth resolver.
export const graphqlIpLimiter = rateLimit({
  ...baseOptions,
  windowMs: FIFTEEN_MINUTES,
  limit: 600,
  handler: tooManyRequests('Too many requests to /api/v1/graphql. Please slow down.'),
});

// ------------------------------ Message --------------------------------------
// Per-user (JWT) AND per-IP. Placed AFTER authAppVerifyToken so req.user
// is populated; that means a compromised shared IP can't spam on behalf
// of every user, and a compromised user can't spam from every IP.

export const messageCreateLimiter = rateLimit({
  ...baseOptions,
  windowMs: 60 * 1000,   // 1 minute
  limit: 30,             // 30 messages / minute / user
  keyGenerator: (req) => `${ipKeyGenerator(req.ip)}|${req.user?.id ?? 'anon'}`,
  handler: tooManyRequests('Too many messages. Please slow down.'),
});

export const messageReadLimiter = rateLimit({
  ...baseOptions,
  windowMs: 60 * 1000,
  limit: 120,            // 120 reads / minute / user
  keyGenerator: (req) => `${ipKeyGenerator(req.ip)}|${req.user?.id ?? 'anon'}`,
  handler: tooManyRequests('Too many requests. Please slow down.'),
});
</file>

